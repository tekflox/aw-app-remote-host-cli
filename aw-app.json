{
  "manifest_version": 1,
  "id": "remote-host-cli",
  "name": "Remote Host CLI",
  "version": "0.18.0",
  "description": "Access the remote hosts linked to your aw-workspace account: contributes an `aw-workspace-cli remote-hosts` command (status/exec/ps plus push/pull file transfer against the BYOD host linked via aw-remote-host) and an MCP server so an agent can do the same, both scoped to only this account's own linked hosts.",
  "tier": "inprocess",
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "remote_host_cli_app.plugin:RemoteHostCliAppPlugin",
    "pip_requires": [
      "httpx",
      "websockets"
    ]
  },
  "permissions": [
    "net:outbound"
  ],
  "contributes": {
    "skills": [
      {
        "id": "aw-app-remote-hosts-cli",
        "path": "skills/aw-app-remote-hosts-cli/SKILL.md",
        "description": "How to check status of, execute commands on, transfer files to/from, and manage processes on the remote hosts linked to this aw-workspace account, via `aw-workspace-cli remote-hosts` or this app's MCP server."
      }
    ],
    "mcp": {
      "provides": [
        "remote_host_status",
        "remote_host_exec_start",
        "remote_host_exec_run",
        "remote_host_exec_status",
        "remote_host_exec_wait",
        "remote_host_exec_kill",
        "remote_host_list_processes",
        "remote_host_list_hosts",
        "remote_host_read_file",
        "remote_host_write_file",
        "remote_host_upload_file",
        "remote_host_download_file",
        "remote_host_list_directory",
        "remote_host_stat",
        "remote_host_mkdir",
        "remote_host_delete",
        "remote_host_firewall_list",
        "remote_host_firewall_add_rule",
        "remote_host_firewall_remove_rule",
        "remote_host_firewall_set_lockdown",
        "remote_host_firewall_status"
      ]
    }
  },
  "dependencies": {},
  "migrations": {}
}
